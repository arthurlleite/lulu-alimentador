# Valores padrão aplicados na primeira compilação (o sdkconfig gerado não vai para o git).

# Flash: 4 MB funciona nas duas placas; a S3 N16R8 tem 16 MB, mas o firmware cabe com folga.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Servidor HTTP: cabeçalhos maiores (navegadores de celular mandam muitos)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Certificados raiz embutidos para MQTT sobre TLS (mqtts://)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Proteções: watchdog de tarefas e detector de queda de tensão (brown-out)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_BROWNOUT_DET=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# A rede de configuração pode ser aberta pelo timer de fallback do Wi-Fi
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Dois servidores NTP (a.st1.ntp.br e pool.ntp.org)
CONFIG_LWIP_SNTP_MAX_SERVERS=2
